// Icon and version info baked into nopbar.exe (built by build.rs).
#include <winver.h>

1 ICON "nopbar.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     NOPBAR_VER_COMMA
PRODUCTVERSION  NOPBAR_VER_COMMA
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "nopbard"
            VALUE "FileDescription",  "NopBar"
            VALUE "FileVersion",      NOPBAR_VER_STR
            VALUE "InternalName",     "nopbar"
            VALUE "LegalCopyright",   "(c) nopbard"
            VALUE "OriginalFilename", "nopbar.exe"
            VALUE "ProductName",      "NopBar"
            VALUE "ProductVersion",   NOPBAR_VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
